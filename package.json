{
  "name": "lumen",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:release-guard": "node scripts/test-release-guard.mjs && node scripts/test-release-scripts.mjs",
